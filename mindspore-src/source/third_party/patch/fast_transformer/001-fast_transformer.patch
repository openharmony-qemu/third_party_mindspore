+    std::cout << "reshaped as: [" << problem.m() / T1 << ", " << T1 << ", "
+      << T2 << ", " << T3 << ", " << problem.n() / T2 / T3 <<"]" << std::endl;
+    std::cout << "finally permuted as: [" << T2 << ", " << problem.m() / T1 << ", "
