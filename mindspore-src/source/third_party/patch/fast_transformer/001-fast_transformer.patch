+    cutlass::int4b_t, cutlass::layout::TensorNDHWC,
+    cutlass::int4b_t, cutlass::layout::TensorNDHWC,
+    float,
+    int32_t,
+    NumericConverterClamp<cutlass::int4b_t, float>
+  >(manifest);
+  
+  make_conv_fprop<
