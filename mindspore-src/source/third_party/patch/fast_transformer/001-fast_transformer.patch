+template <typename T>
+CUTLASS_HOST_DEVICE T &imag(complex<T> &z) {
+  return z.imag();
+}
+
+/// Returns the real part of the real number
+template <typename T>
+CUTLASS_HOST_DEVICE T const &real(T const &r) {
+  return r;
+}
+
+/// Returns the real part of the real number
+template <typename T>
+CUTLASS_HOST_DEVICE T &real(T &r) {
+  return r;
+}
+
+/// Returns the imaginary part of the real number
+template <typename T>
