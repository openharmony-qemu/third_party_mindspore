+
+TEST(complex, host_float) {
+  test::ComplexOperators<float, 32, 8> test;
+}
+
+////////////////////////////////////////////////////////////////////////////////////////////////////
+
+TEST(complex, host_double) {
+  test::ComplexOperators<double, 32, 8> test;
+}
