+///////////////////////////////////////////////////////////////////////////////////////////////////
+
+/// Sleep for a given duration in ms
+void OperationProfiler::sleep(int sleep_duration) {
+  if (sleep_duration) {
+    #ifdef __unix__
+    usleep(sleep_duration * 1000);
+    #elif defined(_WIN32) || defined(WIN32)
+    SleepEx(sleep_duration, false);
+    #else
+    // sleep not supported
+    #endif 
+  }
+}
