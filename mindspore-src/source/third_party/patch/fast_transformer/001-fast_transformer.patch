+        invokeCrossAddFusedQKVBiasTransposeKV<<<grid2, block2, 0, stream>>>(
+            k_buf, v_buf, QKV + m * n, qkv_bias + n2, batch_size, tgt_seq_len, head_num, size_per_head);
