+#pragma once
+
+#include "src/fastertransformer/kernels/activation_kernels.h"
+#include "src/fastertransformer/layers/ms_layers/BaseLayer.h"
+#include "src/fastertransformer/layers/ms_layers/MSBaseLayer.h"
+#include "src/fastertransformer/layers/ms_layers/attention.h"
+#include "src/fastertransformer/layers/ms_layers/ffn.h"
+#include "src/fastertransformer/layers/ms_layers/layer_norm.h"
+
+#include <cublas_v2.h>
+#include <cuda.h>
+
+namespace fastertransformer {
+
+class DecoderBase: public BaseLayerMS {
+public:
+    DecoderBase(size_t batch_size,
+            size_t src_seq_len,
+            size_t tgt_seq_len,
+            size_t head_num,
+            size_t head_size,
+            size_t hidden_size,
+            cublasGemmAlgo_t algo = CUBLAS_GEMM_DEFAULT_TENSOR_OP):BaseLayerMS(batch_size, src_seq_len, tgt_seq_len, head_num, head_size, hidden_size, 1, algo){}
+    bool GetEft();
+    virtual void SetFfnParam(bool ffn_fp16, size_t ffn_hidden_size, FfnBase::ActType act_type = FfnBase::ActType::Gelu, bool ffn_bias = true) = 0;
+    virtual void SetScaleAttn(float scale = 1.0f) = 0;
+    virtual void SetIsLayerNorm(bool is_layernorm, float eps = 1e-6f) = 0;
+    virtual void SetLayerNormPost(bool layernorm_post) = 0;
+    virtual void SetVSL(bool eft) = 0;
+    virtual void SetT5(bool t5) = 0;
+    virtual void SetEps(float eps1, float eps2, float eps3, float eps4 = 1e-6f) = 0;
+    virtual void SetAlgo(cublasGemmAlgo_t algo) override = 0;
+    virtual void SetHTokenNum(size_t h_token_num, size_t h_token_num2) = 0;
+};
+template<typename T>
+class Decoder : public DecoderBase{
+private:
+    std::shared_ptr<Attention<T>> attention_layer1_;
+    std::shared_ptr<Attention<T>> attention_layer2_;
+    std::shared_ptr<FfnBase> ffn_layer_;
+    std::shared_ptr<LayerNorm<T>> layer_norm1_;
+    std::shared_ptr<LayerNorm<T>> layer_norm2_;
+    std::shared_ptr<LayerNorm<T>> layer_norm3_;
+    std::shared_ptr<LayerNorm<T>> layer_norm4_;
+    void ForwardAttention(std::shared_ptr<Attention<T>> attention_layer_, std::vector<void*> &inputs, std::vector<void*> &from_tensor, std::vector<void *> &output, void *ws, cublasHandle_t cublas_handle, cudaStream_t stream);
+    void AddBiasResidual(std::vector<void*> &inputs, const std::vector<void *> &output, cudaStream_t stream);
+
+    void GetCompressBuffer(T* compress_buffer,
+                       T* from_tensor,
+                       int* d_sequence_lengths,
+                       int* padding_offset,
+                       size_t& h_token_num,
+                       size_t* d_token_num,
+                       size_t seq_len,
+                       cudaStream_t stream);
+
+    bool eft_{false};
+    size_t h_token_num_;
+    size_t h_token_num2_;
+    bool layernorm_post_;
+    bool has_beta_;
+    bool is_layernorm_;
+    bool ffn_fp16_;
+    bool is_ffn_fp16_{false};
+
+    size_t normed_from_tensor_buf_;
+    size_t attn_out_buf_;
+    size_t attn_ws_buf_;
+    size_t attn2_out_buf_;
+    size_t attn2_ws_buf_;
+    size_t tmp_out_buf_;
+    size_t ffn_ws_buf_;
+    size_t normed_attn_out_buf_;
+    size_t normed_attn2_out_buf_;
+    size_t compress_buf_;
+    size_t d_token_num_buf_;
+    size_t padding_offset_buf_;
+    size_t d_sequence_lengths_offset_buf_;
+    size_t compress_buf2_;
+    size_t d_token_num_buf2_;
+    size_t padding_offset_buf2_;
+    size_t d_sequence_lengths_offset_buf2_;
+public:
+    void printParam()
+    {
+        std::cout<<"batch_size = "<<batch_size_<<std::endl;
+        std::cout<<"src_seq_len = "<<src_seq_len_<<std::endl;
+        std::cout<<"tgt_seq_len = "<<tgt_seq_len_<<std::endl;
+        std::cout<<"head_num = "<<head_num_<<std::endl;
+        std::cout<<"head_size = "<<head_size_<<std::endl;
+        std::cout<<"hidden_size = "<<hidden_size_<<std::endl;
+        std::cout<<"layernorm_post = "<<layernorm_post_<<std::endl;
+        std::cout<<"has_beta, = "<<has_beta_<<std::endl;
+        std::cout<<"is_layernorm = "<<is_layernorm_<<std::endl;
+        std::cout<<"ffn_fp16 = "<<ffn_fp16_<<std::endl;
+        std::cout<<"h_token_num_ = "<<h_token_num_<<std::endl;
+        std::cout<<"h_token_num2_ = "<<h_token_num2_<<std::endl;
+        std::cout<<"eft_ = "<<eft_<<std::endl;
+        attention_layer1_->printParam();
+        attention_layer2_->printParam();
+        ffn_layer_->printParam();
+    }
+    Decoder(size_t batch_size,
+            size_t src_seq_len,
+            size_t tgt_seq_len,
+            size_t head_num,
+            size_t head_size,
+            size_t hidden_size,
+            float eps1 = 1e-6f,
+            float eps2 = 1e-6f,
+            float eps3 = 1e-6f,
+            float eps4 = 1e-6f,
+            bool layernorm_post = false,
+            bool has_beta = true,
+            bool is_layernorm = false,
+            bool ffn_fp16 = false,
+            bool qkv_bias = true,
+            bool projection_bias = true,
+            bool is_cross = false,
+            bool position_bias = false,
+            float scale = 1.0f,
+            bool mask = true,
+            bool ffn_bias = true,
+            size_t ffn_hidden_size = -1,
+            FfnBase::ActType act_type = FfnBase::ActType::Gelu,
+            cublasGemmAlgo_t algo = CUBLAS_GEMM_DEFAULT_TENSOR_OP);
+    void SetFfnParam(bool ffn_fp16, size_t ffn_hidden_size, FfnBase::ActType act_type = FfnBase::ActType::Gelu, bool ffn_bias = true)
+    {
+        if ((std::is_same<T, float>::value && ffn_fp16 == true) != is_ffn_fp16_) {
+            is_ffn_fp16_  = (std::is_same<T, float>::value && ffn_fp16 == true);
+            if (is_ffn_fp16_) {
+                ffn_layer_ = std::make_shared<Ffn<half>>(batch_size_,
+                                                    src_seq_len_,
+                                                    tgt_seq_len_,
+                                                    head_num_,
+                                                    head_size_,
+                                                    hidden_size_,
+                                                    ffn_bias,
+                                                    ffn_hidden_size,
+                                                    act_type,
+                                                    algo_);
+            }
+            else {
+                ffn_layer_ = std::make_shared<Ffn<T>>(batch_size_,
+                                                    src_seq_len_,
+                                                    tgt_seq_len_,
+                                                    head_num_,
+                                                    head_size_,
+                                                    hidden_size_,
+                                                    ffn_bias,
+                                                    ffn_hidden_size,
+                                                    act_type,
+                                                    algo_);
+            }
+        }
+        ffn_layer_->SetFfnHiddenSize(ffn_hidden_size);
+        ffn_layer_->SetActType(act_type);
+        ffn_layer_->SetffnBias(ffn_bias);
+        
+        if (is_ffn_fp16_) {
+            layer_norm3_->SetType(LayerNorm<T>::Type::ADD_BIAS_RESIDUAL_T5_PRE_CAST);
+        } else {
+            layer_norm3_->SetType(LayerNorm<T>::Type::ADD_BIAS_RESIDUAL_T5_PRE);
+        }
+        ffn_fp16_ = ffn_fp16;
+    }
+    void SetHasBeta(bool has_beta)
+    {
+        has_beta_ = has_beta;
+        layer_norm1_->SetBeta(has_beta);
+        layer_norm2_->SetBeta(has_beta);
+        layer_norm3_->SetBeta(has_beta);
+        if (is_layernorm_)
+            layer_norm4_->SetBeta(has_beta);
+    }
+    void SetScaleAttn(float scale = 1.0f)
+    {
+        attention_layer1_->SetScale(scale);
+        attention_layer2_->SetScale(scale);
+    }
+    void SetIsLayerNorm(bool is_layernorm, float eps)
+    {
+        is_layernorm_ = is_layernorm;
+        if (is_layernorm)
+            layer_norm4_ = std::make_shared<LayerNorm<T>>(has_beta_, false, LayerNorm<T>::Type::T5, eps, algo_); 
+    }
+    void SetLayerNormPost(bool layernorm_post)
+    {
+        layernorm_post_ = layernorm_post;
+    }
+    void SetVSL(bool eft)
+    {
+        eft_ = eft;
+    }
+    void SetT5(bool t5)
+    {
+        attention_layer1_->SetOption(!t5, !t5, t5);
+        attention_layer2_->SetOption(!t5, !t5, t5);
+        ffn_layer_->SetffnBias(!t5);
+        SetHasBeta(!t5);
+    }
+    void SetEps(float eps1, float eps2, float eps3, float eps4)
+    {
+        layer_norm1_->SetEps(eps1);
+        layer_norm2_->SetEps(eps2);
+        layer_norm3_->SetEps(eps3);
+        if (is_layernorm_)
+            layer_norm4_->SetEps(eps4);
+    }
+     void SetAlgo(cublasGemmAlgo_t algo) override
+    {
+        algo_ = algo;
+        ffn_layer_->SetAlgo(algo);
+        attention_layer1_->SetAlgo(algo);
+        attention_layer2_->SetAlgo(algo);
+        layer_norm1_->SetAlgo(algo);
+        layer_norm2_->SetAlgo(algo);
+        layer_norm3_->SetAlgo(algo);
+        if (is_layernorm_)
+            layer_norm4_->SetAlgo(algo);
+    }
+    void SetHTokenNum(size_t h_token_num, size_t h_token_num2 = -1)
+    {
+        h_token_num_ = h_token_num;
+        h_token_num2_ = h_token_num2;
+        ffn_layer_->SetHTokenNum(h_token_num);
+        attention_layer1_->SetHTokenNum(h_token_num, h_token_num);
+        attention_layer2_->SetHTokenNum(h_token_num, h_token_num2);
+    }
+    void SetIsCross(bool is_cross)
+    {
+        attention_layer2_->SetCross(is_cross);
+    }
+    bool GetEft()
+    {
+        return eft_;
+    }
+    size_t GetWorkspaceSize() override;
+    void forward(std::vector<void*> &inputs, const std::vector<void *> &output, void *ws, cublasHandle_t cublas_handle, cudaStream_t stream);
+};
+template class Decoder<float>;
+template class Decoder<half>;
+}  // namespace fastertransformer
