+/// Reduces value into the data pointed to by ptr (complex<T> specialization)
+template <typename T>
+struct red<complex<T>> {
+  CUTLASS_DEVICE
+  void operator()(complex<T> *ptr, const complex<T> &data)
+  {
+    data.red(ptr);
+  }
+};
