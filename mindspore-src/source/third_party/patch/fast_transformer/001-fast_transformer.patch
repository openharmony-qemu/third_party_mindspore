+{ 
+    common_param_.stream = stream_;
+    common_param_.cublas_handle = cublas_handle;
+    common_param_.batch_size = max_batch_size;
+    common_param_.src_seq_len = max_src_seq_len;
+    common_param_.tgt_seq_len = max_tgt_seq_len;
