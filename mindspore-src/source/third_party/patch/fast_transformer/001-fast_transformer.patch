+
+#define BIND_TENSOR_EQUAL(Element, Layout) { \
+    m.def("equals", py::overload_cast< \
+        const cutlass::TensorView<Element, Layout>&, const cutlass::TensorView<Element, Layout>&>( \
+        &cutlass::reference::host::TensorEquals<Element, Layout>)); \
+}
