+      layout::ColumnMajor,
+      half_t,
+      layout::RowMajor,
+      arch::OpMultiplyAdd>;
+
+    Array<half_t, 2> *ptr_D = reinterpret_cast<Array<half_t, 2> *>(&D);
+    Array<half_t, 1> const *ptr_A = reinterpret_cast<Array<half_t, 1> const *>(&A);
+    Array<half_t, 2> const *ptr_B = reinterpret_cast<Array<half_t, 2> const *>(&B);
+
+    Mma mma;
