+      get<1>(problem_shape) = get<0>(args.problem_shape);
+    }
+    return {
+      args.mode,
+      problem_shape,
+      CollectiveMainloop::to_underlying_arguments(args, workspace),
+      CollectiveEpilogue::to_underlying_arguments(args, workspace)
+    };
+  }
+
