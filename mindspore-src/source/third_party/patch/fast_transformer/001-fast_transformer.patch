+        LayerNorm(bool has_beta = true,
+                bool has_bias = false,
+                Type type = 0,
+                float eps = 1e-6f,
+                cublasGemmAlgo_t algo = CUBLAS_GEMM_DEFAULT_TENSOR_OP):BaseLayerMS(0, 0, 0, 0, 0, 0, 0, algo){
