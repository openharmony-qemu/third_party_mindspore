+uint64_t GetTimeUs()
+{
+    const int USEC = 1000000;
+    const int MSEC = 1000;
+    struct timespec ts = {0, 0};
+    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) {
+        return 0;
+    }
+    uint64_t retval = (uint64_t)((ts.tv_sec * USEC) + (ts.tv_nsec / MSEC));
+    return retval;
+}
