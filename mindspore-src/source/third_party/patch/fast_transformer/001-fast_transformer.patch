+    common_param_.hidden_size = head_num * size_per_head;
+    common_param_.in_idx = 0;
+    common_param_.algo = CUBLAS_GEMM_DEFAULT_TENSOR_OP;
+    common_param_.use_past = false;
+    common_param_.query_layer = false;
+    common_param_.h_token_num = max_batch_size * max_src_seq_len;
+    attn_param_.common_param = &common_param_;
+    attn_param_.attn.qkv_bias = !is_position_bias;
+    attn_param_.attn.projection_bias = !is_position_bias;
+    attn_param_.attn.is_cross = is_cross;
+    attn_param_.attn.position_bias = is_position_bias;
+    attn_param_.attn.mask = true;
+    attn_param_.attn.scale = is_position_bias ? 1.0f : 1.0f / sqrtf(size_per_head * 1.0f);
