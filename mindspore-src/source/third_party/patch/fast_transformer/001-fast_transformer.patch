+
+template <int N>
+using uint_byte = uint_bit<8*N>;
+
+template <int N>
+using uint_byte_t = typename uint_byte<N>::type;
+
+//
+// sizeof_bytes
+//
+
+template <class T>
+struct sizeof_bytes {
+  static constexpr std::size_t value = sizeof(T);
+};
