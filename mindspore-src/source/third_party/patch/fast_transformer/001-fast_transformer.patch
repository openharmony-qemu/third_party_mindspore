+void FreeDesc(std::vector<Tensor>& desc)
+{
+    for (size_t i = 0; i < desc.size(); i++) {
+        if (desc[i].where == MEMORY_GPU) {
+            cudaFree((float*)desc[i].data);
+        }
+        else if (desc[i].where == MEMORY_CPU) {
+            free((float*)desc[i].data);
+        }
+    }
+}
