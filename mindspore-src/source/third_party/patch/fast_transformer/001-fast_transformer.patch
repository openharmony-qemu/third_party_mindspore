+  //
+  // Methods
+  //
+
+  Gemm_dReLU_packed_bits_reference_op() { }
+
+  ElementCompute operator()(
+    ElementAccumulator d_y, 
+    ElementT t) const {
+    
+    ElementCompute result = ElementCompute(d_y);
+
+    bool cond = bool(t);
+    if (!cond) {
+      result = ElementCompute();
+    }
+
+    return result;
+  }
+};
