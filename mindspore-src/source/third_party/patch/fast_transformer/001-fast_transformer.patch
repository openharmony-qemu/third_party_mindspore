+CUTLASS_TEST_L1(SM50_device_cgemm_nn, 32x32x8_32x32x1_8x4_4x8_1x1, {
+    using precision = cutlass::complex<float>;
+    using ThreadblockShape = cutlass::gemm::GemmShape<32, 32, 8>;
