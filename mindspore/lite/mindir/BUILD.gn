import("//build/ohos.gni")

ohos_shared_library("mindir") {
  include_dirs = [
    "../",
    "../../core",
    "include",
    "include/inner",
    "//third_party/flatbuffers/include",
  ]
  sources = [
    "../src/common/log.cc",
    "src/lite_graph.cc",
    "src/mindir.cc",
    "src/tensor.cc",
    "src/utils.cc",
  ]
  external_deps = [
    "drivers_interface_nnrt:libnnrt_proxy_1.0",
    "hdf_core:libhdi",
    "hilog_native:libhilog",
    "ipc:ipc_core",
    "utils_base:utils",
  ]
  deps = [ "//drivers/interface/nnrt/v1_0:nnrt_idl_headers" ]
  subsystem_name = "mindspore"
  part_name = "mindir"
}
