From 2f1bcc439c065dece4e178982387014a3a10a435 Mon Sep 17 00:00:00 2001
From: Zhu Guodong <zhuguodong0001@163.com>
Date: Thu, 27 Jul 2023 19:56:04 +0800
Subject: [PATCH] auto-apply 0038-adapt-nnrt-ext-deps.patch

---
 mindspore/lite/BUILD.gn | 14 ++++++++++++--
 1 file changed, 12 insertions(+), 2 deletions(-)

diff --git a/mindspore/lite/BUILD.gn b/mindspore/lite/BUILD.gn
index 86b80a28..a4cfa7b8 100644
--- a/mindspore/lite/BUILD.gn
+++ b/mindspore/lite/BUILD.gn
@@ -714,6 +714,7 @@ ohos_shared_library("mindspore_lib") {
     "../../third_party/",
     "./schema/",
     "../ccsrc/",
+    "//foundation/ai/neural_network_runtime/",
   ]
 
   defines = [
@@ -774,7 +775,11 @@ ohos_shared_library("mindspore_lib") {
       "mindir/include",
       "mindir/inner_headers",
     ]
-    external_deps += [ "neural_network_runtime:nnrt_target" ]
+    if (mindspore_feature_nnrt_metagraph) {
+        external_deps += [ "hiai_foundation:nnrt_ext_target" ]
+    } else {
+        external_deps += [ "neural_network_runtime:nnrt_target" ]
+    }
     deps += [ "mindir:mindir_lib" ]
     defines += [ "SUPPORT_NNRT" ]
   }
@@ -814,6 +819,7 @@ ohos_shared_library("mindspore_ndk") {
     "../../third_party/",
     "./schema/",
     "../ccsrc/",
+    "//foundation/ai/neural_network_runtime/",
   ]
 
   defines = [
@@ -828,7 +834,11 @@ ohos_shared_library("mindspore_ndk") {
     ":secure_option",
   ]
 
-  external_deps = [ "neural_network_runtime:nnrt_target" ]
+  if (mindspore_feature_nnrt_metagraph) {
+      external_deps = [ "hiai_foundation:nnrt_ext_target" ]
+  } else {
+      external_deps = [ "neural_network_runtime:nnrt_target" ]
+  }
 
   remove_configs = [ "//build/config/compiler:no_rtti" ]
 
-- 
2.34.1

