From: wangqianggang <2593994958@qq.com>
Date: Fri, 10 Jan 2025 15:25:24 +0800
Subject: [PATCH] fix hi-app-event report negative timestamp

---
 mindspore/lite/src/common/hi_app_event/hi_app_event_thread.cc | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/mindspore/lite/src/common/hi_app_event/hi_app_event_thread.cc b/mindspore/lite/src/common/hi_app_event/hi_app_event_thread.cc
index 8118d36a..c0f6cd55 100644
--- a/mindspore/lite/src/common/hi_app_event/hi_app_event_thread.cc
+++ b/mindspore/lite/src/common/hi_app_event/hi_app_event_thread.cc
@@ -130,6 +130,10 @@ void HiAppEventThread::Submit(const int result, const int err_code, const std::s
     // add and merge the data by api_name
     std::lock_guard<std::mutex> lock(mutex_);
     int64_t cost_time = end_time - begin_time;
+    if (cost_time < 0) {
+        MS_LOG(WARNING) << api_name <<"'s cost_time is negative, don't report it.";
+        return;
+    }
     auto iter = event_map_.find(api_name);
     if (iter != event_map_.end()) {
         std::shared_ptr<EventInfo> event_info = iter->second;
-- 
