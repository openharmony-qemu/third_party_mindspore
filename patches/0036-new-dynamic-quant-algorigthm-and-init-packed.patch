+    *quant_value = max_value;
+  } else if (real_value == -INFINITY) {
+    *quant_value = min_value;
+  } else {
+    int temp = round(real_value * inverse_scale + zp);
+    temp = temp < max_value ? temp : max_value;
+    temp = temp > min_value ? temp : min_value;
+    *quant_value = (int8_t)temp;
+  }
+  return NNACL_OK;
