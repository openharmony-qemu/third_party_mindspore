+ConvertHalfPrecision:
+// from single-precision convert to half-precision
+    fcvtn v16.4h,v16.4s
+    fcvtn v17.4h,v17.4s
+    fcvtn v18.4h,v18.4s
+    fcvtn v19.4h,v19.4s
+
+    fcvtn v20.4h,v20.4s
+    fcvtn v21.4h,v21.4s
+    fcvtn v22.4h,v22.4s
+    fcvtn v23.4h,v23.4s
+
+    fcvtn v24.4h,v24.4s
+    fcvtn v25.4h,v25.4s
+    fcvtn v26.4h,v26.4s
+    fcvtn v27.4h,v27.4s
+
+    fcvtn v28.4h,v28.4s
+    fcvtn v29.4h,v29.4s
+    fcvtn v30.4h,v30.4s
+    fcvtn v31.4h,v31.4s
+
+AddBias:
+    // +bias
+    cbz x5, StoreData
+    ld1 {v1.4h, v2.4h, v3.4h, v4.4h}, [x5]
+
+    fadd v16.4h,v16.4h,v1.4h
+    fadd v17.4h,v17.4h,v2.4h
+    fadd v18.4h,v18.4h,v3.4h
