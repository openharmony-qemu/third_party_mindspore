+#ifndef MINDSPORE_LITE_SRC_RUNTIME_RUNTIME_PACKED_NODE_PASS_
+#define MINDSPORE_LITE_SRC_RUNTIME_RUNTIME_PACKED_NODE_PASS_
+
+#include <string>
+#include <map>
+#include <vector>
+#include "src/runtime/lite_model.h"
+#include "src/tensor.h"
+#include "src/runtime/kernel_exec.h"
