+int GetBucketIndex(int dims[], int dim_size, int prefer_axis, int data_index) {
+  int stride = 1;
+  int bucket_count = dims[prefer_axis];
+  for (int i = prefer_axis + 1; i < dim_size; i++) {
+    stride *= dims[i];
+  }
+  if (stride == 0 || bucket_count == 0) {
+    return 0;
+  }
+  return (data_index / stride) % bucket_count;
+}
