+                           CPUOpCoderCreator<ScaleDynamicFP16Coder>)
+REG_DYNAMIC_OPERATOR_CODER(kARM64, kNumberTypeFloat16, PrimitiveType_ScaleFusion,
+                           CPUOpCoderCreator<ScaleDynamicFP16Coder>)
+}  // namespace mindspore::lite::micro::nnacl
