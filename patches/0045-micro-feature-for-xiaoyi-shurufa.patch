+        super().__init__()
+        self.lstm = ops.LSTM(input_s, hidden_s, num_layers, has_bias, bidirectional, dropout, proj_size)
+        real_hidden_size = proj_size if proj_size > 0 else hidden_s
+        weights_size = 4 * hidden_s * (input_s + real_hidden_size)
+        if proj_size > 0:
