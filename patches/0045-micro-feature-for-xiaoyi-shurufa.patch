+                           CPUOpCoderCreator<SliceDynamicFP16Coder>)
+REG_DYNAMIC_OPERATOR_CODER(kARM64, kNumberTypeFloat16, PrimitiveType_SliceFusion,
+                           CPUOpCoderCreator<SliceDynamicFP16Coder>)
