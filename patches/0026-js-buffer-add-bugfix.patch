From 7a77ed4dfb5347eca7aaab0102fcd2127ea0b4f7 Mon Sep 17 00:00:00 2001
From: fangzhou12 <fangzhou12@huawei.com>
Date: Wed, 14 Jun 2023 09:07:55 +0800
Subject: [PATCH] buffer add bugfix

---
 mindspore/lite/src/runtime/js_api/mslite_model_napi.cc | 2 +-
 mindspore/lite/src/runtime/js_api/mstensor_napi.cc     | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/mindspore/lite/src/runtime/js_api/mslite_model_napi.cc b/mindspore/lite/src/runtime/js_api/mslite_model_napi.cc
index 167c4a90..4ebc1a3d 100644
--- a/mindspore/lite/src/runtime/js_api/mslite_model_napi.cc
+++ b/mindspore/lite/src/runtime/js_api/mslite_model_napi.cc
@@ -278,7 +278,7 @@ napi_value MSLiteModelNapi::Constructor(napi_env env, napi_callback_info info) {
   }
 
   status = napi_wrap(env, thisVar, reinterpret_cast<void *>(model_napi), MSLiteModelNapi::Finalize, nullptr,
-                     &(model_napi->wrapper_));
+                     nullptr);
   if (status != napi_ok) {
     delete model_napi;
     napi_get_undefined(env, &result);
diff --git a/mindspore/lite/src/runtime/js_api/mstensor_napi.cc b/mindspore/lite/src/runtime/js_api/mstensor_napi.cc
index cd8044e9..898e81bd 100644
--- a/mindspore/lite/src/runtime/js_api/mstensor_napi.cc
+++ b/mindspore/lite/src/runtime/js_api/mstensor_napi.cc
@@ -69,7 +69,7 @@ napi_value MSTensorNapi::Constructor(napi_env env, napi_callback_info info) {
   }
 
   tensprNapi->env_ = env;
-  status = napi_wrap(env, jsThis, tensprNapi, MSTensorNapi::Finalize, nullptr, &(tensprNapi->wrapper_));
+  status = napi_wrap(env, jsThis, tensprNapi, MSTensorNapi::Finalize, nullptr, nullptr);
   if (status != napi_ok) {
     delete tensprNapi;
     MS_LOG(ERROR) << "Failed to wrap native instance";
-- 
2.17.1

