+  if (status != napi_ok || modelNapi == nullptr) {
+    MS_LOG(ERROR) << "get model napi error";
+    return undefinedResult;
+  }
+
+  if (SetModelInputs(env, argv[PARAM0], modelNapi->native_model_) != SUCCESS) {
+    MS_LOG(ERROR) << "set tensor data failed";
