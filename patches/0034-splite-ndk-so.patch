From b9195df86090c2b3b5ef6f0f320fb9262c952d01 Mon Sep 17 00:00:00 2001
From: Zhu Guodong <zhuguodong0001@163.com>
Date: Mon, 10 Jul 2023 11:20:41 +0800
Subject: [PATCH] auto-apply 0034-splite-ndk-so.patch

---
 mindspore/lite/BUILD.gn | 61 ++++++++++++++++++++++++++++++++++++++---
 1 file changed, 57 insertions(+), 4 deletions(-)

diff --git a/mindspore/lite/BUILD.gn b/mindspore/lite/BUILD.gn
index cf0a74ab..92ace734 100644
--- a/mindspore/lite/BUILD.gn
+++ b/mindspore/lite/BUILD.gn
@@ -68,9 +68,9 @@ import("//build/ohos.gni")
 ohos_group("mindspore") {
   deps = [
     ":mindspore_lib",
+    ":mindspore_ndk",
     ":mindspore_train_lib",
     "mindir:mindir_lib",
-    "tools/benchmark:benchmark_bin",
     "src/runtime/js_api:mindsporelite_napi"
   ]
 }
@@ -181,7 +181,6 @@ lite_mindrt_sources = [
 ]
 
 all_lite_sources += cxx_api_sources
-all_lite_sources += c_api_sources
 all_lite_sources += api_source
 all_lite_sources += control_flow_kernel_sources
 all_lite_sources += experimental_sources
@@ -749,7 +748,7 @@ ohos_shared_library("mindspore_lib") {
 
   external_deps = [ "hilog:libhilog" ]
 
-  output_name = "libmindspore-lite.huawei"
+  output_name = "libmindspore-lite"
   output_extension = "so"
   innerapi_tags = [ "platformsdk"]
   SUPPORT_NNRT = true
@@ -760,7 +759,6 @@ ohos_shared_library("mindspore_lib") {
       "src/runtime/delegate/nnrt/nnrt_model_kernel.cc",
     ]
     include_dirs += [
-      "//foundation/ai/neural_network_runtime",
       "src/delegate/nnrt/include",
       "../../mindspore/core/ir",
       "mindir/include",
@@ -784,6 +782,61 @@ ohos_shared_library("mindspore_lib") {
   subsystem_name = "thirdparty"
 }
 
+# NDK lib
+ohos_shared_library("mindspore_ndk") {
+  deps = [
+    ":mindspore_lib"
+  ]
+
+  sources = c_api_sources
+
+  include_dirs = [
+    "//third_party/flatbuffers/include",
+    "./",
+    "../",
+    "../../",
+    "../core",
+    "src",
+    "src/c_api/",
+    "../ccsrc/plugin/device/cpu/kernel/",
+    "../core/mindrt/src/",
+    "../core/mindrt/include/",
+    "../../third_party/",
+    "./schema/",
+    "../ccsrc/",
+  ]
+
+  defines = [
+    "SUPPORT_NNRT",
+    "PRIMITIVE_WRITEABLE",
+    "VERSION_STR=\"1.8.1\"",
+  ]
+
+  configs = [
+    ":mindspore_api",
+    ":disable_android",
+    ":secure_option",
+  ]
+
+  external_deps = [ "neural_network_runtime:nnrt_target" ]
+
+  remove_configs = [ "//build/config/compiler:no_rtti" ]
+
+  output_name = "libmindspore_lite_ndk"
+  output_extension = "so"
+  innerapi_tags = [ "ndk"]
+  cflags_cc = [
+    "-Wno-ignored-qualifiers",
+    "-Wunused-private-field",
+    "-Wno-unused-private-field",
+    "-Wno-inconsistent-missing-override",
+    "-Wno-macro-redefined",
+    "-Wno-constant-conversion",
+  ]
+  part_name = "mindspore"
+  subsystem_name = "thirdparty"
+}
+
 # Train library
 expression_cxx_api_sources = [
   "src/runtime/cxx_api/expression/net.cc",
-- 
2.34.1

