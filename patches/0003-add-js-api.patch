+void MSTensorNapi::Finalize(napi_env env, void *nativeObject, void *finalize) {
+  (void)env;
+  (void)finalize;
+  if (nativeObject != nullptr) {
+    delete reinterpret_cast<MSTensorNapi *>(nativeObject);
+  }
+  MS_LOG(INFO) << "Finalize success.";
+}
