+        int32_t indice = input_indices[i * inner_size + j];
+        result = SIMD_ADD_F32(result, SIMD_LD_F32(input_data + indice * input_data_inner_size + index));
+      }
+      SIMD_ST_F32(output_data + i * input_data_inner_size + index, result);
+    }
+  }
+  return index;
+}
