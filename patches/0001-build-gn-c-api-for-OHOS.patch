+    fs_sub = SIMD_SUB_F32(fs_sub, fs_mean);
+    SIMD_F32 fs_pow = SIMD_MUL_F32(fs_sub, fs_sub);
+    fs_deviation = SIMD_ADD_F32(fs_deviation, fs_pow);
