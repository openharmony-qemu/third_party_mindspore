+  int64_t index, float *var, float alpha, float l1, float l2, float *delta, int64_t size) {
+  SIMD_F32 alpha_vec = SIMD_MOV_F32(alpha);
+  SIMD_F32 l1_vec = SIMD_MOV_F32(l1);
+  SIMD_F32 l2_vec = SIMD_MOV_F32(l2);
