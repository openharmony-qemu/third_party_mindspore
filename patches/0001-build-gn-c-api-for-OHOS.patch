new file mode 100644
index 00000000..90cc0dd5
--- /dev/null
+++ b/mindspore/ccsrc/plugin/device/cpu/kernel/nnacl/include/nnacl/sse/activation_fp32_sse.h
@@ -0,0 +1,285 @@
+/**
