+static inline int Fp32CastGatherReduceInt64FusionSSE(int index, float *output_data, const int64_t *input_indices, const float *input_data,
+                                                          int32_t inner_size, int32_t input_data_inner_size, int32_t outer_start,
+                                                          int32_t outer_end) {
