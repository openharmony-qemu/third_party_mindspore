+void MindIR_Tensor_Destroy(TensorPtr *tensor) {
+  if (tensor != nullptr && *tensor != nullptr) {
+    auto schema = static_cast<schema::Tensor *>(*tensor);
+    MindIRMemoryManager::GetInstance()->DeleteTensor(schema);
+    *tensor = nullptr;
+  }
+  *tensor = nullptr;
+}
