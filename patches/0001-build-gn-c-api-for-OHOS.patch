+      SIMD_F32 res = SIMD_MUL_F32(SIMD_MUL_F32(para3, in), SIMD_ADD_F32(para2, SIMD_ERF_APPROXIMATEAVX512(SIMD_DIV_F32(in, para1))));
+      SIMD_ST_F32(dst + index, res);
