+template <typename T>
+float TensorSum(const void *data, int size) {
+  const T *typed_data = reinterpret_cast<const T *>(data);
+  float sum = 0.f;
+  for (int i = 0; i < size; i++) {
+    sum += static_cast<float>(typed_data[i]);
+  }
+  return sum;
+}
