From 9908b3b01855a4bb5fa0f8ded7ec9839c1a53de4 Mon Sep 17 00:00:00 2001
From: chengfeng27 <chengfeng27@huawei.com>
Date: Thu, 31 Oct 2024 15:56:11 +0800
Subject: [PATCH] fix multi thread nnrt infer failed

---
 mindspore/lite/src/litert/c_api/tensor_c.cc        | 14 ++++++++++++++
 .../src/litert/delegate/nnrt/nnrt_allocator.cc     | 12 +++++++++++-
 .../lite/src/litert/delegate/nnrt/nnrt_allocator.h | 10 +++++++++-
 mindspore/lite/src/tensor.cc                       |  3 ++-
 4 files changed, 36 insertions(+), 3 deletions(-)

diff --git a/mindspore/lite/src/litert/c_api/tensor_c.cc b/mindspore/lite/src/litert/c_api/tensor_c.cc
index 4e7a1e56..127a8bc1 100644
--- a/mindspore/lite/src/litert/c_api/tensor_c.cc
+++ b/mindspore/lite/src/litert/c_api/tensor_c.cc
@@ -18,6 +18,9 @@
 #include "include/api/status.h"
 #include "src/tensor.h"
 #include "src/litert/cxx_api/tensor/tensor_impl.h"
+#ifdef SUPPORT_NNRT
+#include "src/litert/delegate/nnrt/nnrt_allocator.h"
+#endif
 
 // allocator_table contains mapping of raw_ptr to weak_ptr of Allocator, allocator_table_mutex is used in multi-thread
 // scene when user build multiple models, to avoid read/write unordered_map conflicts crash.
@@ -26,7 +29,18 @@ static std::mutex allocator_table_mutex;
 
 void CleanAllocatorTable() {
   std::lock_guard<std::mutex> lock(allocator_table_mutex);
+#ifdef SUPPORT_NNRT
+  auto nnrt_allocator = mindspore::lite::NNRTAllocator::GetInstance().get();
+  for (auto it = allocator_table.begin(); it != allocator_table.end(); ) {
+    if (it->first != nnrt_allocator) {
+      it = allocator_table.erase(it);
+    } else {
+      ++it;
+    }
+  }
+#else
   allocator_table.clear();
+#endif
 }
 
 OH_AI_TensorHandle OH_AI_TensorCreate(const char *name, OH_AI_DataType type, const int64_t *shape, size_t shape_num,
diff --git a/mindspore/lite/src/litert/delegate/nnrt/nnrt_allocator.cc b/mindspore/lite/src/litert/delegate/nnrt/nnrt_allocator.cc
index c160315e..3ba9182b 100644
--- a/mindspore/lite/src/litert/delegate/nnrt/nnrt_allocator.cc
+++ b/mindspore/lite/src/litert/delegate/nnrt/nnrt_allocator.cc
@@ -46,12 +46,19 @@ void NNRTAllocator::ClearFreeList() {
   free_list_.clear();
 }
 
-void NNRTAllocator::FreeAllocatedTensor(void *data) {
+void NNRTAllocator::FreeAllocatedTensor(void *data, lite::Tensor *tensor) {
   std::lock_guard<std::mutex> locker(mutex_);
   auto iter = allocated_list_.find(data);
   if (iter == allocated_list_.end()) {
     return;
   }
+
+  auto iter_tensor = allocated_lite_tensors_.find(data);
+  if (iter_tensor == allocated_lite_tensors_.end() || iter_tensor->second != tensor) {
+    MS_LOG(INFO) << "data: " << data << " not belong to lite tensor: " << tensor << ", skip free";
+    return;
+  }
+
   auto membuf = iter->second;
   if (membuf == nullptr) {
     MS_LOG(ERROR) << "membuf in allocated_list_ is nullptr, data: " << data;
@@ -59,10 +66,12 @@ void NNRTAllocator::FreeAllocatedTensor(void *data) {
   }
   membuf->ref_count_ = 0;
   (void)allocated_list_.erase(iter);
+  (void)allocated_lite_tensors_.erase(data);
   OH_NNTensor_Destroy(&membuf->tensor_);
   OH_NNTensorDesc_Destroy(&membuf->tensor_desc_);
   delete membuf;
   membuf = nullptr;
+  data = nullptr;
 }
 
 NNRTAllocator::~NNRTAllocator() {
@@ -193,6 +202,7 @@ void NNRTAllocator::Free(void *ptr) {
   auto membuf = iter->second;
   membuf->ref_count_ = 0;
   (void)allocated_list_.erase(iter);
+  (void)allocated_lite_tensors_.erase(ptr);
   (void)free_list_.insert(std::make_pair(membuf->size, membuf));
 }
 
diff --git a/mindspore/lite/src/litert/delegate/nnrt/nnrt_allocator.h b/mindspore/lite/src/litert/delegate/nnrt/nnrt_allocator.h
index 9d7fa3c0..fa2fe1ba 100644
--- a/mindspore/lite/src/litert/delegate/nnrt/nnrt_allocator.h
+++ b/mindspore/lite/src/litert/delegate/nnrt/nnrt_allocator.h
@@ -59,7 +59,14 @@ class NNRTAllocator : public Allocator {
   }
   void SetDeviceId(size_t id) { device_id_ = id; }
   void ClearFreeList();
-  void FreeAllocatedTensor(void *data);
+  void FreeAllocatedTensor(void *data, lite::Tensor *tensor);
+  void AddAllocatedLiteTensor(void *data, lite::Tensor *tensor) {
+    if (data == nullptr) {
+      return;
+    }
+    std::lock_guard<std::mutex> locker(mutex_);
+    allocated_lite_tensors_[data] = tensor;
+  }
 
  private:
   struct MemBuf {
@@ -76,6 +83,7 @@ class NNRTAllocator : public Allocator {
   // <membuf->memory_->data, membuf>
   std::unordered_map<void *, MemBuf *> allocated_list_;
   std::multimap<size_t, MemBuf *> free_list_;
+  std::unordered_map<void *, lite::Tensor *> allocated_lite_tensors_;
 };
 
 }  // namespace lite
diff --git a/mindspore/lite/src/tensor.cc b/mindspore/lite/src/tensor.cc
index 7e54a80c..89607e08 100644
--- a/mindspore/lite/src/tensor.cc
+++ b/mindspore/lite/src/tensor.cc
@@ -119,7 +119,7 @@ Tensor::~Tensor() {
   this->tensor_c_.data_ = nullptr;
 #ifdef SUPPORT_NNRT
   if (this->own_data_ && IS_NNRT_ALLOCATOR(allocator_)) {
-    NNRTAllocator::GetInstance()->FreeAllocatedTensor(allocated_data);
+    NNRTAllocator::GetInstance()->FreeAllocatedTensor(allocated_data, this);
   }
 #endif
 }
@@ -444,6 +444,7 @@ int Tensor::MallocData(const AllocatorPtr allocator) {
                                                                                             this->data_type(),
                                                                                             this->format(),
                                                                                             this->tensor_name());
+      dynamic_cast<NNRTAllocator *>(allocator_.get())->AddAllocatedLiteTensor(this->tensor_c_.data_, this);
     } else {
 #endif
       this->tensor_c_.data_ = allocator_->Malloc(data_size);
-- 
2.17.1

