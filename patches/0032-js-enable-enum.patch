+            }
+        }
+    }
+    MS_LOG(ERROR) << "CreateThreadAffinityModeObject is Failed!";
+    napi_get_undefined(env, &result);
+    return result;
+}
+
+napi_status MSLiteModelNapi::AddNamedProperty(napi_env env, napi_value object,
+                                              const std::string name, int32_t enumValue)
+{
+    napi_status status;
+    napi_value enumNapiValue;
+
+    status = napi_create_int32(env, enumValue, &enumNapiValue);
+    if (status == napi_ok) {
+        status = napi_set_named_property(env, object, name.c_str(), enumNapiValue);
+    }
+    return status;
+}
