+                                                        const std::vector<char> &weight_file, bool is_inference,
+                                                        bool enable_fp16,
+                                                        const std::vector<std::vector<char>> &changeable_weights_name) {
+  if (model.impl_ == nullptr) {
+    MS_LOG(ERROR) << "Model implement is null.";
+    return kLiteUninitializedObj;
