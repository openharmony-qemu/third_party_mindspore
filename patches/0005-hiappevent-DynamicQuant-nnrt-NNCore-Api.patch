+HiAppEventConfig::HiAppEventConfig() {
+  if (handler_thread_ == nullptr) {
+    handler_thread_ = std::make_unique<HandlerThread>();
+    handler_thread_->Run();
+    handler_ = handler_thread_->GetHandler();
+  }
+}
