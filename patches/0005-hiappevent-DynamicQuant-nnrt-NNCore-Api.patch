+uint64_t HiAppEventConfig::GetTimeMs() {
+  struct timespec ts = {0, 0};
+  if (clock_gettime(CLOCK_REALTIME, &ts) != 0) {
+    return 0;
+  }
+  uint64_t ret_val = static_cast<uint64_t>(ts.tv_sec * 1000LL + ts.tv_nsec / 1000000);
+  return ret_val;
+}
