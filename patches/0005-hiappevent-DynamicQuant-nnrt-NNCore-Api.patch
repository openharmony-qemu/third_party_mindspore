+    for (size_t i = 0; i < nn_output_count; i++) {
+      NN_TensorDesc *tensor_desc_tmp = OH_NNExecutor_CreateOutputTensorDesc(oh_nn_executor, i);
+      if (tensor_desc_tmp == nullptr) {
